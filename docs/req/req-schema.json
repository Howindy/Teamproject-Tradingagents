{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "D1 Requirements Registry Schema",
  "description": "Structural schema for the machine-readable D1 requirements registry. It validates document structure, field shapes, enumerations, and local conditions only. It does not validate application behavior, implementation, test results, runtime manifests, publication protocols, source-path existence, cross-record consistency, or business semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document",
    "scope",
    "stakeholders",
    "definitions",
    "baseline_observations",
    "requirements",
    "conflict_resolutions",
    "moscow",
    "traceability",
    "validation",
    "open_questions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "document": {
      "$ref": "#/$defs/document"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "stakeholders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stakeholder"
      }
    },
    "definitions": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "additionalProperties": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "baseline_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/baselineObservation"
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "conflict_resolutions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflictResolution"
      }
    },
    "moscow": {
      "$ref": "#/$defs/moscow"
    },
    "traceability": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/traceabilityEntry"
      }
    },
    "validation": {
      "$ref": "#/$defs/validation"
    },
    "open_questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openQuestion"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "requirementId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]{2}$"
    },
    "fcId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]{2}-FC[0-9]{2}$"
    },
    "dateString": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "versionString": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "documentStatus": {
      "enum": [
        "draft",
        "approved",
        "superseded"
      ]
    },
    "requirementType": {
      "enum": [
        "functional",
        "invariant",
        "quality",
        "performance",
        "cost",
        "governance",
        "security"
      ]
    },
    "priority": {
      "enum": [
        "Must",
        "Should",
        "Could",
        "Won't"
      ]
    },
    "requirementStatus": {
      "enum": [
        "draft",
        "approved",
        "deferred"
      ]
    },
    "sourceType": {
      "enum": [
        "code",
        "document",
        "measured_baseline"
      ]
    },
    "measurementStatus": {
      "enum": [
        "not_measured",
        "measured"
      ]
    },
    "thresholdStatus": {
      "enum": [
        "not_applicable",
        "undetermined",
        "provisional",
        "approved"
      ]
    },
    "comparisonOperator": {
      "enum": [
        "==",
        "!=",
        "<",
        "<=",
        ">",
        ">="
      ]
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "version",
        "status",
        "date",
        "language",
        "description",
        "baseline_ref"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "#/$defs/versionString"
        },
        "status": {
          "$ref": "#/$defs/documentStatus"
        },
        "date": {
          "$ref": "#/$defs/dateString"
        },
        "language": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "baseline_ref": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_ids",
        "draft_ids",
        "deferred_ids",
        "in_scope",
        "out_of_scope",
        "assumptions"
      ],
      "properties": {
        "approved_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirementId"
          },
          "uniqueItems": true
        },
        "draft_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirementId"
          },
          "uniqueItems": true
        },
        "deferred_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirementId"
          },
          "uniqueItems": true
        },
        "in_scope": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "stakeholder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "interest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "interest": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "baselineObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "value",
        "unit",
        "measured",
        "measurement_status",
        "source",
        "notes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "statement": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/nonEmptyString"
            }
          ]
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "measured": {
          "type": "boolean"
        },
        "measurement_status": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "notes": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "locator",
        "description",
        "source_type"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "locator": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_type": {
          "$ref": "#/$defs/sourceType"
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "evidence"
      ],
      "properties": {
        "origin": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "fitCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "input",
        "expected_result",
        "verification",
        "zero_tolerance",
        "measurement_status",
        "threshold_status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/fcId"
        },
        "input": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "expected_result": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "verification": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "zero_tolerance": {
          "type": "boolean"
        },
        "measurement_status": {
          "$ref": "#/$defs/measurementStatus"
        },
        "threshold_status": {
          "$ref": "#/$defs/thresholdStatus"
        },
        "metric": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "operator": {
          "$ref": "#/$defs/comparisonOperator"
        },
        "threshold": {
          "type": [
            "number",
            "null"
          ],
          "$comment": "A null threshold marks an undetermined target, such as the deferred PR-01 performance target; it does not mean zero or a pass. A numeric zero can be a zero-tolerance rule, such as CR-01's computation or claim-boundary criteria, rather than a cost-benefit target."
        },
        "unit": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "threshold"
                ]
              },
              {
                "required": [
                  "operator"
                ]
              },
              {
                "required": [
                  "unit"
                ]
              }
            ]
          },
          "then": {
            "required": [
              "metric"
            ]
          }
        }
      ],
      "$comment": "threshold_status is descriptive metadata about the threshold's status. not_applicable does not forbid a threshold field, and a present threshold does not require threshold_status to be approved. Measurement status is independent of threshold status."
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "priority",
        "status",
        "stakeholders",
        "sources",
        "problem",
        "statement",
        "fit_criterion",
        "tradeoff",
        "implementation_dependencies",
        "constraint_relations",
        "conflicts",
        "assumptions",
        "notes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/requirementId"
        },
        "type": {
          "$ref": "#/$defs/requirementType"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "status": {
          "$ref": "#/$defs/requirementStatus"
        },
        "stakeholders": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "sources": {
          "$ref": "#/$defs/sources"
        },
        "problem": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "statement": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "fit_criterion": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fitCriterion"
          }
        },
        "tradeoff": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "implementation_dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirementId"
          },
          "uniqueItems": true
        },
        "constraint_relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirementId"
          },
          "uniqueItems": true
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "notes": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "invariant"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "fit_criterion": {
                "items": {
                  "properties": {
                    "zero_tolerance": {
                      "const": true
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "performance"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "fit_criterion": {
                "items": {
                  "required": [
                    "metric",
                    "threshold",
                    "unit"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "conflictResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirements",
        "description",
        "resolution"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requirementId"
          }
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "resolution": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "wontItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reason"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "moscow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "must",
        "should",
        "could",
        "wont",
        "rationale"
      ],
      "properties": {
        "must": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirementId"
          },
          "uniqueItems": true
        },
        "should": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirementId"
          },
          "uniqueItems": true
        },
        "could": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirementId"
          },
          "uniqueItems": true
        },
        "wont": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/wontItem"
          }
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "traceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "locator",
        "description"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "locator": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "traceabilityEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "req_id",
        "code_refs",
        "baseline_refs",
        "notes"
      ],
      "properties": {
        "req_id": {
          "$ref": "#/$defs/requirementId"
        },
        "code_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/traceRef"
          }
        },
        "baseline_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/traceRef"
          }
        },
        "notes": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "result",
        "details"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "pending"
          ]
        },
        "details": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "approvalRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_at",
        "approval_basis",
        "baseline_version",
        "approval_scope",
        "deferred_ids",
        "fc_id_format",
        "fc_mapping_ref",
        "freeze_files",
        "change_control",
        "limitations",
        "prior_baseline_version",
        "revision_scope"
      ],
      "properties": {
        "approved_at": {
          "$ref": "#/$defs/dateString"
        },
        "approval_basis": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "baseline_version": {
          "$ref": "#/$defs/versionString"
        },
        "approval_scope": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirementId"
          }
        },
        "deferred_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirementId"
          }
        },
        "fc_id_format": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "fc_mapping_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "freeze_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "change_control": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "limitations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "prior_baseline_version": {
          "$ref": "#/$defs/versionString"
        },
        "revision_scope": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current",
        "checks",
        "history"
      ],
      "properties": {
        "current": {
          "$ref": "#/$defs/validationCurrent"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/validationCheck"
          }
        },
        "history": {
          "$ref": "#/$defs/validationHistory"
        }
      }
    },
    "openQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "impact",
        "blocking"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "question": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "impact": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "blocking": {
          "type": "boolean"
        }
      }
    },
    "validationStatus": {
      "enum": [
        "pending",
        "passed",
        "failed"
      ]
    },
    "humanReviewStatus": {
      "enum": [
        "pending",
        "approved",
        "changes_required",
        "rejected"
      ]
    },
    "validationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "method",
        "result",
        "details"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "kind": {
          "enum": [
            "command",
            "one_time"
          ]
        },
        "method": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "pending"
          ]
        },
        "details": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "validationCurrent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document",
        "schema",
        "structural_status",
        "consistency_status",
        "scope",
        "working_directory",
        "dependencies",
        "command",
        "ci_status",
        "ci_note",
        "application_status",
        "application_note",
        "design_approval_note",
        "limitations"
      ],
      "properties": {
        "document": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "schema": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "structural_status": {
          "$ref": "#/$defs/validationStatus"
        },
        "consistency_status": {
          "$ref": "#/$defs/validationStatus"
        },
        "scope": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "working_directory": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "dependencies": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "command": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "ci_status": {
          "enum": [
            "not_integrated",
            "integrated"
          ]
        },
        "ci_note": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "application_status": {
          "enum": [
            "not_run",
            "run"
          ]
        },
        "application_note": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "design_approval_note": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "validationHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicable_version",
        "status",
        "machine_status",
        "human_review_status",
        "human_review_notes",
        "schema",
        "script",
        "command",
        "result_record",
        "tool",
        "status_note",
        "checks",
        "notes",
        "approval_record"
      ],
      "properties": {
        "applicable_version": {
          "$ref": "#/$defs/versionString"
        },
        "status": {
          "$ref": "#/$defs/validationStatus"
        },
        "machine_status": {
          "$ref": "#/$defs/validationStatus"
        },
        "human_review_status": {
          "$ref": "#/$defs/humanReviewStatus"
        },
        "human_review_notes": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "schema": {
