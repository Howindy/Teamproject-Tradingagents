{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradingagents.local/schemas/req-schema.json",
  "title": "D1 Requirements Registry",
  "description": "Schema for the D1 requirements registry and product narrative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document",
    "scope",
    "stakeholders",
    "definitions",
    "baseline_observations",
    "requirements",
    "conflict_resolutions",
    "moscow",
    "traceability",
    "validation",
    "open_questions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "version",
        "status",
        "date",
        "language",
        "description",
        "baseline_ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 10
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "status": {
          "enum": [
            "approved",
            "draft"
          ]
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "language": {
          "const": "en"
        },
        "description": {
          "type": "string",
          "minLength": 50
        },
        "baseline_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_ids",
        "in_scope",
        "out_of_scope",
        "assumptions"
      ],
      "properties": {
        "approved_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requirement_id"
          }
        },
        "in_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "out_of_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "draft_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement_id"
          }
        }
      }
    },
    "stakeholders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "interest"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 3
          },
          "interest": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "definitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_query_key",
        "logical_query",
        "query_execution",
        "vendor_cache",
        "availability_record",
        "source",
        "critical_requirement",
        "record_status",
        "requirement_status",
        "critical_gap",
        "coverage_status",
        "coverage_snapshot",
        "gate_input",
        "gate_result",
        "model_proposal",
        "formal_decision",
        "gate_reason_code",
        "artifact_binding",
        "canonicalization",
        "provenance_digest",
        "artifact_contract",
        "publish_state",
        "invariant_checkpoint",
        "secret_value",
        "secret_pattern_rule",
        "scan_scope",
        "redaction_policy",
        "secret_scan_result",
        "endpoint_audit_record",
        "endpoint_restore_record",
        "safety_gate",
        "zero_tolerance",
        "run_manifest",
        "sensitive_url_parameter",
        "component_missing_record",
        "decision_digest",
        "record_hash",
        "memory_entry_binding",
        "critical_profile",
        "run_clock",
        "evidence_requirement_link",
        "input_hash",
        "review_class",
        "decision_id",
        "behavior_evaluation_contract",
        "evaluation_rubric",
        "eval_set_version",
        "inheritance_record",
        "entry_digest",
        "evidence_digest",
        "portfolio_risk_input",
        "candidate_trade",
        "portfolio_risk_policy_snapshot",
        "portfolio_risk_result",
        "risk_reason_code",
        "risk_input_digest",
        "risk_input_ref",
        "risk_behavior_evaluation",
        "valuation_cutoff",
        "run_id",
        "formal_publication",
        "recovery_snapshot",
        "recovery_claim",
        "report_section_manifest",
        "history_query",
        "export_target",
        "recovery_benchmark",
        "publication_snapshot",
        "history_reference_closure",
        "financial_fact",
        "financial_period",
        "derived_metric",
        "metric_block",
        "metric_conflict",
        "downstream_brief",
        "brief_budget_policy",
        "brief_evaluation",
        "metric_claim",
        "metric_evidence_bundle",
        "context_audit_metadata"
      ],
      "properties": {
        "data_query_key": {
          "type": "string",
          "minLength": 20
        },
        "logical_query": {
          "type": "string",
          "minLength": 20
        },
        "query_execution": {
          "type": "string",
          "minLength": 20
        },
        "vendor_cache": {
          "type": "string",
          "minLength": 20
        },
        "availability_record": {
          "type": "string",
          "minLength": 20
        },
        "source": {
          "type": "string",
          "minLength": 20
        },
        "critical_requirement": {
          "type": "string",
          "minLength": 20
        },
        "record_status": {
          "type": "string",
          "minLength": 20
        },
        "requirement_status": {
          "type": "string",
          "minLength": 20
        },
        "critical_gap": {
          "type": "string",
          "minLength": 20
        },
        "coverage_status": {
          "type": "string",
          "minLength": 20
        },
        "coverage_snapshot": {
          "type": "string",
          "minLength": 20
        },
        "gate_input": {
          "type": "string",
          "minLength": 20
        },
        "gate_result": {
          "type": "string",
          "minLength": 20
        },
        "model_proposal": {
          "type": "string",
          "minLength": 20
        },
        "formal_decision": {
          "type": "string",
          "minLength": 20
        },
        "gate_reason_code": {
          "type": "string",
          "minLength": 20
        },
        "artifact_binding": {
          "type": "string",
          "minLength": 20
        },
        "canonicalization": {
          "type": "string",
          "minLength": 20
        },
        "provenance_digest": {
          "type": "string",
          "minLength": 20
        },
        "artifact_contract": {
          "type": "string",
          "minLength": 20
        },
        "publish_state": {
          "type": "string",
          "minLength": 20
        },
        "invariant_checkpoint": {
          "type": "string",
          "minLength": 20
        },
        "secret_value": {
          "type": "string",
          "minLength": 20
        },
        "secret_pattern_rule": {
          "type": "string",
          "minLength": 20
        },
        "scan_scope": {
          "type": "string",
          "minLength": 20
        },
        "redaction_policy": {
          "type": "string",
          "minLength": 20
        },
        "secret_scan_result": {
          "type": "string",
          "minLength": 20
        },
        "endpoint_audit_record": {
          "type": "string",
          "minLength": 20
        },
        "endpoint_restore_record": {
          "type": "string",
          "minLength": 20
        },
        "safety_gate": {
          "type": "string",
          "minLength": 20
        },
        "zero_tolerance": {
          "type": "string",
          "minLength": 20
        },
        "run_manifest": {
          "type": "string",
          "minLength": 20
        },
        "sensitive_url_parameter": {
          "type": "string",
          "minLength": 20
        },
        "component_missing_record": {
          "type": "string",
          "minLength": 20
        },
        "decision_digest": {
          "type": "string",
          "minLength": 20
        },
        "record_hash": {
          "type": "string",
          "minLength": 20
        },
        "memory_entry_binding": {
          "type": "string",
          "minLength": 20
        },
        "critical_profile": {
          "type": "string",
          "minLength": 20
        },
        "run_clock": {
          "type": "string",
          "minLength": 20
        },
        "evidence_requirement_link": {
          "type": "string",
          "minLength": 20
        },
        "input_hash": {
          "type": "string",
          "minLength": 20
        },
        "review_class": {
          "type": "string",
          "minLength": 20
        },
        "decision_id": {
          "type": "string",
          "minLength": 20
        },
        "behavior_evaluation_contract": {
          "type": "string",
          "minLength": 20
        },
        "evaluation_rubric": {
          "type": "string",
          "minLength": 20
        },
        "eval_set_version": {
          "type": "string",
          "minLength": 20
        },
        "inheritance_record": {
          "type": "string",
          "minLength": 20
        },
        "entry_digest": {
          "type": "string",
          "minLength": 20
        },
        "evidence_digest": {
          "type": "string",
          "minLength": 20
        },
        "portfolio_risk_input": {
          "type": "string",
          "minLength": 20,
          "description": "Authoritative caller/application-supplied structured portfolio valuation and candidate trade with one currency and valuation time."
        },
        "candidate_trade": {
          "type": "string",
          "minLength": 20,
          "description": "Structured new-long stock candidate trade with validated order value, entry, stop, action, position effect, instrument type, leverage, and order count."
        },
        "portfolio_risk_result": {
          "type": "string",
          "minLength": 20,
          "description": "Deterministic portfolio-risk result with evaluation status, closed risk reason codes, ratios, effective order value, policy version, threshold status, input digest, valuation time, currency, and evaluation time."
        },
        "risk_reason_code": {
          "type": "string",
          "minLength": 20,
          "description": "Closed portfolio-risk reason-code set used by the deterministic evaluator and the shared SafetyGate."
        },
        "risk_input_digest": {
          "type": "string",
          "minLength": 20,
          "description": "SHA-256 over the canonical authoritative portfolio-risk input and policy version used by one evaluation."
        },
        "portfolio_risk_policy_snapshot": {
          "type": "string",
          "minLength": 20,
          "description": "Locatable policy snapshot with actual concentration and stop thresholds, freshness window, precision rule, threshold status, human approval reference, and digest."
        },
        "risk_input_ref": {
          "type": "string",
          "minLength": 20,
          "description": "Run-scoped locatable reference to the canonical stored risk-input artifact with relative path, SHA-256, and file hash scope."
        },
        "risk_behavior_evaluation": {
          "type": "string",
          "minLength": 20,
          "description": "Separate cache A/B and risk-policy behavior evaluations with fixed risk policy in cache comparison and a dedicated risk-policy threshold set."
        },
        "valuation_cutoff": {
          "type": "string",
          "minLength": 20,
          "description": "Unique timezone-aware risk valuation cutoff derived as min(run_clock.now_utc, end of run_clock.as_of_date in run_clock.timezone); future analysis dates are rejected, never clipped."
        },
        "run_id": {
          "type": "string",
          "minLength": 20,
          "description": "Team run invocation identity, unique per invocation, path-safe, preserved across publication retries and recovery; UUIDv4 is not required."
        },
        "formal_publication": {
          "type": "string",
          "minLength": 20,
          "description": "Formal publication lifecycle and the rule that terminal manifest completed plus read-time INV-01 is the only commit condition."
        },
        "recovery_snapshot": {
          "type": "string",
          "minLength": 20,
          "description": "Complete durably written and read-back-verified redacted formal records and fixed render inputs for model-free startup recovery."
        },
        "recovery_claim": {
          "type": "string",
          "minLength": 20,
          "description": "Atomic per-run recovery claim or lease with duplicate-start, stale-claim, isolation, bounded-retry, and single-success rules."
        },
        "report_section_manifest": {
          "type": "string",
          "minLength": 20,
          "description": "Versioned-renderer and current-capability section list with section paths, state fields, byte sizes, hashes, and complete-report digest."
        },
        "history_query": {
          "type": "string",
          "minLength": 20,
          "description": "Historical publication query with optional ticker/date intersection filters, canonical normalization, deterministic order, bounded results, and typed unknown/corrupt behavior."
        },
        "export_target": {
          "type": "string",
          "minLength": 20,
          "description": "User-selected export destination that must not overwrite a non-empty target and does not migrate or modify legacy reports."
        },
        "recovery_benchmark": {
          "type": "string",
          "minLength": 20,
          "description": "Fixed recovery performance workload, 30 reset trials, nearest-rank p95, provisional 2-second target, environment metadata, and retained failure samples."
        },
        "publication_snapshot": {
          "type": "string",
          "minLength": 20,
          "description": "Permanent formal record set for one committed publication, retained after cleanup and authoritative for history and formal references; distinct from the temporary recovery envelope."
        },
        "history_reference_closure": {
          "type": "string",
          "minLength": 20,
          "description": "Transitive source proof for reused historical memory references in a verified export package, or an explicit scope limitation when source proof is unavailable."
        },
        "financial_fact": {
          "type": "string",
          "minLength": 20,
          "description": "Structured SEC filing fact with period, unit, currency, filed_at, source, fact identity, sign, and restatement lineage."
        },
        "financial_period": {
          "type": "string",
          "minLength": 20,
          "description": "Period identity by start/end, fiscal year/quarter, span, duration, and restatement lineage; near dates are not merged."
        },
        "derived_metric": {
          "type": "string",
          "minLength": 20,
          "description": "Deterministic metric with formula, inputs, period, precision, status, source fact IDs, and structured n/a reason."
        },
        "metric_block": {
          "type": "string",
          "minLength": 20,
          "description": "Code-generated authoritative numeric metric block with stable IDs, formulas, sources, periods, status, and n/a reasons."
        },
        "metric_conflict": {
          "type": "string",
          "minLength": 20,
          "description": "Disclosed narrative-versus-computed-metric mismatch with unverified narrative labeling and no authoritative wrong number."
        },
        "downstream_brief": {
          "type": "string",
          "minLength": 20,
          "description": "Bounded downstream context view for the five debate roles, with mandatory gaps/metrics/sources and compressible narrative."
        },
        "brief_budget_policy": {
          "type": "string",
          "minLength": 20,
          "description": "Versioned mandatory/compressible budget, overflow rejection or expansion, Unicode, marker, character, and token rules."
        },
        "brief_evaluation": {
          "type": "string",
          "minLength": 20,
          "description": "Controlled brief-on/off evaluation measuring added output, reduced input, net token/cost, fidelity, gaps, quality, and safety."
        },
        "metric_claim": {
          "type": "string",
          "minLength": 20,
          "description": "Structured model claim with explicit metric_id, period, and parseable value; the only claim scope for deterministic metric-conflict detection."
        },
        "metric_evidence_bundle": {
          "type": "string",
          "minLength": 20,
          "description": "Persisted facts, formula/fact/policy versions, metric block, input digest, and result digest stored in permanent and recovery snapshots for model-free recovery."
        },
        "context_audit_metadata": {
          "type": "string",
          "minLength": 20,
          "description": "Separate brief audit metadata with source summary, policy version, mandatory digest, omissions, budget decision, fallback reason, and resolvable reference handle."
        }
      }
    },
    "baseline_observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "value",
          "unit",
          "measured",
          "measurement_status",
          "source",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^BO-[0-9]{2}$"
          },
          "statement": {
            "type": "string",
            "minLength": 20
          },
          "value": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "measured": {
            "type": "boolean"
          },
          "measurement_status": {
            "enum": [
              "measured",
              "not_measured",
              "partially_measured",
              "not_applicable"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": [
              "number",
              "null"
            ]
          },
          "target_status": {
            "enum": [
              "approved",
              "provisional",
              "not_applicable",
              null
            ]
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "conflict_resolutions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requirements",
          "description",
          "resolution"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^C-[0-9]{2}$"
          },
          "requirements": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/$defs/requirement_id"
            }
          },
          "description": {
            "type": "string",
            "minLength": 20
          },
          "resolution": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "moscow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "must",
        "should",
        "could",
        "wont",
        "rationale"
      ],
      "properties": {
        "must": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement_id"
          }
        },
        "should": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement_id"
          }
        },
        "could": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement_id"
          }
        },
        "wont": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "reason"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 3
              },
              "reason": {
                "type": "string",
                "minLength": 20
              }
            }
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "traceability": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "req_id",
          "code_refs",
          "baseline_refs",
          "notes"
        ],
        "properties": {
          "req_id": {
            "$ref": "#/$defs/requirement_id"
          },
          "code_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "baseline_refs": {
            "type": "array",
            "minItems": 0,
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "schema",
        "tool",
        "checks",
        "notes",
        "script",
        "command",
        "result_record",
        "machine_status",
        "human_review_status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "result",
              "details"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 3
              },
              "result": {
                "enum": [
                  "pass",
                  "fail",
                  "pending"
                ]
              },
              "details": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "script": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "result_record": {
          "type": "string",
          "minLength": 1
        },
        "machine_status": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "human_review_status": {
          "enum": [
            "pending",
            "approved",
            "changes_required",
            "rejected"
          ]
        },
        "human_review_notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "open_questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "impact",
          "blocking"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OQ-[0-9]{2}$"
          },
          "question": {
            "type": "string",
            "minLength": 20
          },
          "impact": {
            "type": "string",
            "minLength": 10
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "requirement_id": {
      "type": "string",
      "pattern": "^(FR|INV|QR|PR|CR|GR|SR|SB)-[0-9]{2}$"
    },
    "acceptance_id": {
      "type": "string",
      "pattern": "^(FR|INV|QR|PR|CR|GR|SR|SB)-[0-9]{2}-AC[0-9]+$"
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "locator",
        "description"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "source_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "locator",
        "description",
        "source_type"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 10
        },
        "source_type": {
          "enum": [
            "code",
            "measured_baseline",
            "document",
            "inference",
            "open_question"
          ]
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "input",
        "expected_result",
        "verification",
        "zero_tolerance",
        "measurement_status",
        "threshold_status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/acceptance_id"
        },
        "input": {
          "type": "string",
          "minLength": 15
        },
        "expected_result": {
          "type": "string",
          "minLength": 15
        },
        "verification": {
          "type": "string",
          "minLength": 15
        },
        "zero_tolerance": {
          "type": "boolean"
        },
        "measurement_status": {
          "enum": [
            "measured",
            "not_measured",
            "partially_measured",
            "not_applicable"
          ]
        },
        "threshold_status": {
          "enum": [
            "approved",
            "provisional",
            "not_applicable"
          ]
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "priority",
        "status",
        "stakeholders",
        "source",
        "problem",
        "statement",
        "acceptance_criteria",
        "conflicts",
        "assumptions",
        "notes",
        "implementation_dependencies",
        "constraint_relations"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/requirement_id"
        },
        "type": {
          "enum": [
            "functional",
            "invariant",
            "quality",
            "performance",
            "cost",
            "governance",
            "security",
            "safety"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 8
        },
        "priority": {
          "enum": [
            "must",
            "should",
            "could",
            "wont"
          ]
        },
        "status": {
          "enum": [
            "approved",
            "draft",
            "deferred"
          ]
        },
        "stakeholders": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origin",
            "evidence"
          ],
          "properties": {
            "origin": {
              "type": "string",
              "minLength": 5
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/source_evidence"
              }
            }
          }
        },
        "problem": {
          "type": "string",
          "minLength": 30
        },
        "statement": {
          "type": "string",
          "minLength": 50
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/acceptance"
          }
        },
        "conflicts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 15
          }
        },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 15
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "implementation_dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement_id"
          }
        },
        "constraint_relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement_id"
          }
        }
      }
    }
  }
}
