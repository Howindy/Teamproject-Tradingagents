{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "status": {
          "const": "draft"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "language": {
          "const": "en"
        },
        "baseline_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      },
      "required": [
        "id",
        "title",
        "version",
        "status",
        "date",
        "language",
        "baseline_commit"
      ]
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "users": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "workflow": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "objective",
        "users",
        "workflow"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(FR|QR|INV)-[0-9]{2}$"
          }
        },
        "in_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "requirement_ids",
        "in_scope",
        "out_of_scope"
      ]
    },
    "stakeholders": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "interest": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "interest"
        ]
      }
    },
    "definitions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "analysis_date": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_ready": {
          "type": "string",
          "minLength": 1
        },
        "committed": {
          "type": "string",
          "minLength": 1
        },
        "complete_report": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "run_id",
        "analysis_date",
        "snapshot_ready",
        "committed",
        "complete_report"
      ]
    },
    "baseline_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "measured": {
            "const": false
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "source_type": {
                "const": "code"
              }
            },
            "required": [
              "path",
              "locator",
              "description",
              "source_type"
            ]
          }
        },
        "required": [
          "id",
          "statement",
          "measured",
          "source"
        ]
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(FR|QR|INV)-[0-9]{2}$"
          },
          "type": {
            "enum": [
              "functional",
              "quality",
              "invariant"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": [
              "must",
              "should",
              "could",
              "wont"
            ]
          },
          "status": {
            "const": "draft"
          },
          "stakeholders": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "origin": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_type": {
                      "const": "code"
                    }
                  },
                  "required": [
                    "path",
                    "locator",
                    "description",
                    "source_type"
                  ]
                }
              }
            },
            "required": [
              "origin",
              "evidence"
            ]
          },
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^(FR|QR|INV)-[0-9]{2}-AC[0-9]+$"
                },
                "input": {
                  "type": "string",
                  "minLength": 1
                },
                "expected_result": {
                  "type": "string",
                  "minLength": 1
                },
                "verification": {
                  "type": "string",
                  "minLength": 1
                },
                "zero_tolerance": {
                  "type": "boolean"
                },
                "measurement_status": {
                  "const": "not_measured"
                }
              },
              "required": [
                "id",
                "input",
                "expected_result",
                "verification",
                "zero_tolerance",
                "measurement_status"
              ]
            }
          },
          "metric": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "const": "archive_batch_recovery_duration_seconds"
                  },
                  "unit": {
                    "const": "seconds"
                  },
                  "threshold": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "comparison": {
                    "const": "<="
                  },
                  "percentile": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "trials": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "rank": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "committed_runs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "pending_runs": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "max_snapshot_bytes": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "threshold_status": {
                    "const": "design_target"
                  }
                },
                "required": [
                  "name",
                  "unit",
                  "threshold",
                  "comparison",
                  "percentile",
                  "trials",
                  "rank",
                  "committed_runs",
                  "pending_runs",
                  "max_snapshot_bytes",
                  "threshold_status"
                ]
              }
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(FR|QR|INV)-[0-9]{2}$"
            }
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "type",
          "title",
          "priority",
          "status",
          "stakeholders",
          "source",
          "problem",
          "statement",
          "acceptance_criteria",
          "metric",
          "dependencies",
          "conflicts",
          "assumptions",
          "notes"
        ]
      }
    },
    "moscow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "must": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(FR|QR|INV)-[0-9]{2}$"
          }
        },
        "should": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(FR|QR|INV)-[0-9]{2}$"
          }
        },
        "could": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(FR|QR|INV)-[0-9]{2}$"
          }
        },
        "wont": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tradeoff": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "must",
        "should",
        "could",
        "wont",
        "tradeoff"
      ]
    },
    "conflict_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "requirements": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "pattern": "^(FR|QR|INV)-[0-9]{2}$"
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "requirements",
          "description",
          "resolution"
        ]
      }
    },
    "traceability": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "req_id": {
            "type": "string",
            "pattern": "^(FR|QR|INV)-[0-9]{2}$"
          },
          "code_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "path",
                "locator",
                "description"
              ]
            }
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "req_id",
          "code_refs",
          "notes"
        ]
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "enum": [
                  "pass",
                  "fail"
                ]
              },
              "details": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "result",
              "details"
            ]
          }
        }
      },
      "required": [
        "status",
        "schema",
        "checks"
      ]
    }
  },
  "required": [
    "schema_version",
    "document",
    "product",
    "scope",
    "stakeholders",
    "definitions",
    "baseline_observations",
    "requirements",
    "moscow",
    "conflict_resolutions",
    "traceability",
    "validation"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradingagents.local/schemas/report-archive-requirements.json",
  "title": "Report Archive D1 Requirements Registry"
}
