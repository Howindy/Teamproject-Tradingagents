{
  "fixture_version": "brief-eval-states-v2",
  "semantics": {
    "blocked": "required pre-run inputs, snapshots, prices, thresholds, or human approval are missing/invalid; observed failures are recorded but do not hide the block",
    "ready": "all pre-run inputs are valid and no result exists for the current attempt; normal no-result is ready, not blocked or failed",
    "accepted": "evaluation executed from ready; result evidence is valid and every applicable quality, safety, evidence, and cost condition passes",
    "failed": "evaluation executed from ready and result evidence is missing/corrupt/inconsistent, or any quality, safety, or cost condition fails"
  },
  "claim_rules": {
    "budget_met": "net_cost <= approved net_cost_max",
    "local_cost_saving": "net_cost < 0 under the local cost attribution formula",
    "token_reduction": "net_tokens < 0; no independent token target",
    "zero_difference": "net_cost = 0; no strict saving",
    "positive_within_budget": "net_cost >= 0 and <= approved net_cost_max; budget met only",
    "whole_application_saving": "never claimed from local cost attribution"
  },
