{
  "fixture_version": "brief-eval-states-v4",
  "contract_ref": "docs/req/evaluation/brief-eval-contract-v4.json",
  "semantics": {
    "execution_status": "not_started, running, completed, or aborted; single execution-state authority.",
    "acceptance_status": "blocked, ready, accepted, failed, or null while running; pending and aborted are forbidden values.",
    "running": "execution_status=running requires acceptance_status=null.",
    "terminal": "completed maps to accepted or failed; aborted maps to failed. accepted/failed are terminal for the current attempt.",
    "run_completed": "auxiliary only; if present it must equal (execution_status == completed)."
  },
  "claim_rules": {
    "budget_met": "net_cost <= approved net_cost_max",
    "local_cost_saving": "net_cost < 0 under the local cost attribution formula",
    "token_reduction": "net_tokens < 0; no independent token target",
    "zero_difference": "net_cost = 0; no strict saving",
    "positive_within_budget": "net_cost >= 0 and <= approved net_cost_max; budget met only",
    "whole_application_saving": "never claimed from local cost attribution"
  },
