// CS5351 D3 project permission configuration, English; target: OpenCode 1.19.3 (V1 syntax).
// Source inputs: AGENTS.md, docs/architecture/permission-model.md,
// docs/code-governance/mcp-tool-manifest.md, and D4 verification constraints.
// Course-required location: .opencode/permissions.jsonc. This name is NOT auto-loaded.
// Explicit launch from the application root (not executed by this authoring task):
// OPENCODE_CONFIG="$PWD/.opencode/permissions.jsonc" opencode
// Source: https://github.com/anomalyco/opencode/blob/v1.19.3/packages/opencode/src/config/config.ts
// V1 rule schema: packages/core/src/v1/config/permission.ts in the same tag.
// Do not substitute V2 permissions/shell/subagent syntax into this V1 configuration.
// The moving official schema URL is editor guidance, not proof of V1 compatibility.
//
// Fail-closed initial state: no approved round plan, no shell execution, no discovery,
// no external access, network tools, skill loading, delegation, or MCP grants.
// OpenCode 1.19.3 read/write/edit tools check paths relative to the project worktree.
// These read/edit patterns therefore use project-relative paths. Explicit loading
// is still required; configuration presence alone does not establish enforcement.
// Simple wildcard '*' includes separators; this is not a gitignore '**' protocol.
// Read allowances are role maxima, not permission to consume unrelated evidence.
// Read AGENTS/governance explicitly; leave secrets and version-control metadata denied.
// Edit 'ask' is a confirmation point inside the D2 role maximum, NEVER standing write
// authorization. Approve only exact files in an approved task; do not save broad
// Allow-always grants. Plan has no plan-file write grant. This file does not create
// docs/plans/round-01.md or approve tests, OQ-07, or security-critical implementation.
//
// Before a development round, a human must select/confirm the role, narrow edit/read
// paths to the approved task, and add only required discovery/command/output rules.
// glob/grep permission resources are not reliable file-read allowlists; they remain
// denied here rather than falsely claiming content-search confinement. Use direct
// allowed reads initially. Shell remains denied because it can bypass file rules;
// approved test commands need reviewed environment, output and side-effect bounds.
// Global/project/agent config and saved permissions may merge with this file.
// Review effective merged policy before claiming activation. No runtime permission
// check or effective-config dump was executed here (to avoid incidental writes or
// secret disclosure). JSON syntax/static rule checks are not an enforcement test.
//
// Enforce canonical project ownership at tool/OS boundaries; wildcard rules alone
// do not prove symlink confinement, command isolation, or all-tool coverage. Unknown
// tool actions remain denied. No OS sandbox, branch protection, CI gate, provider
// transport restriction, or approval timestamp is established by this document.
// Creating this file is authorized; agents must not later self-edit it to expand access.
// First-round plan read is explicitly whitelisted; its existence, write permission,
// approval and implementation are separate. Later round paths must be declared.
// No shell or edit grant is added by this read-only plan reference.
{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "permission": {
    "*": "deny",
    "read": {
      "*": "deny",
      "AGENTS.md": "allow",
      "Prompt.md": "allow",
      "docs/plans/round-01.md": "allow",
      "goal.md": "allow",
      "docs/req/*": "allow",
      "architecture-blueprint.md": "allow",
      "docs/architecture/*": "allow",
      "docs/code-governance/*": "allow",
      ".opencode/permissions.jsonc": "allow",
      ".opencode/rules.md": "allow",
      ".agent/rules.md": "allow",
      "*/.env": "deny",
      "*/.env.*": "deny",
      ".env": "deny",
      ".env.*": "deny",
      "*/.git/*": "deny",
      ".git/*": "deny",
      "*credentials*": "deny",
      "*.pem": "deny",
      "*.key": "deny"
    },
    "edit": "deny",
    "bash": "deny",
    "glob": "deny",
    "grep": "deny",
    "list": "deny",
    "external_directory": "deny",
    "task": "deny",
    "skill": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "lsp": "deny",
    "question": "allow",
    "todowrite": "allow"
  },
  "agent": {
    "plan": {
      "description": "CS5351 plan responsibility; OQ-07 role deployment remains pending.",
      "mode": "primary",
      "permission": {
        "read": {
