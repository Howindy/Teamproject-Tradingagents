          "test/offline/*": "allow",
          "test/live/*": "allow",
          "pyproject.toml": "allow",
          "requirements.txt": "allow",
          "baseline/*/summary.md": "allow",
          "baseline/*/metrics*.json": "allow",
          "baseline/*/report-consistency.json": "allow",
