      "/Users/ichihann/Desktop/CS5351/Teamproject-tradingagents/.agent/rules.md": "allow",
      "*/.env": "deny",
      "*/.env.*": "deny",
      ".env": "deny",
      ".env.*": "deny",
      "*/.git/*": "deny",
      ".git/*": "deny",
      "*credentials*": "deny",
      "*.pem": "deny",
      "*.key": "deny"
    },
    "edit": "deny",
